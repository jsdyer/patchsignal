{
  "id": "patchsignal",
  "title": "Patch Signal",
  "description": "Check CVE shortlists against known exploitation, inspect affected versions and follow patch guidance.",
  "category": "security",
  "tags": [
    "cisa",
    "kev",
    "epss",
    "cve",
    "patch",
    "zero",
    "day",
    "vulnerability"
  ],
  "icon": "crosshair",
  "url": "/patchsignal/",
  "source": "https://github.com/jsdyer/patchsignal",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "mixed",
    "detail": "CISA KEV shortlist matching runs locally; individual CVE records and FIRST EPSS estimates load on request.",
    "cadence": "Daily",
    "probes": [
      {
        "url": "https://coolcode.ca/patchsignal/kev.json",
        "path": [
          "built"
        ],
        "label": "Snapshot generated",
        "count_at": {
          "path": [
            "rows"
          ],
          "unit": "KEV entries",
          "measure": "length"
        }
      },
      {
        "url": "https://coolcode.ca/patchsignal/kev.json",
        "path": [
          "kevDate"
        ],
        "label": "Source published"
      },
      {
        "url": "https://coolcode.ca/patchsignal/kev.json",
        "path": [
          "epssDate"
        ],
        "label": "EPSS score date"
      }
    ]
  }
}
